{
  "name": "vscode-plugin-dictionary",
  "displayName": "vscode-plugin-dictionary",
  "description": "translate English word into Chinese without leaving vscode",
  "author": {
    "name": "JasonZhang"
  },
  "publisher": "JasonZhang155",
  "repository": {
    "type": "github",
    "url": "https://github.com/zhangzhuang15/JasonPackages"
  },
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.81.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "JasonZhang",
    "Translate Tool",
    "Vscode Locally",
    "Translate English Word To Chinese",
    "youdao",
    "iciba"
  ],
  "activationEvents": [
    "onCommand:*"
  ],
  "main": "./dist/extension.js",
  "icon": "./images/dictionary.png",
  "contributes": {
    "commands": [
      {
        "command": "vscode-plugin-dictionary.toggleTranslateEnglish",
        "title": "Toggle to Translate English"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-plugin-dictionary.toggleTranslateEnglish",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "vscode-plugin-dictionary.toggleTranslateEnglish"
        }
      ]
    },
    "configuration": {
      "title": "vscode-plugin-dictionary",
      "type": "object",
      "properties": {
        "vscodePluginDictionary.translator": {
          "type": "string",
          "enum": [
            "iciba",
            "youdao"
          ],
          "enumItemLabels": [
            "金山翻译",
            "有道翻译"
          ],
          "default": "iciba"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "publish": "vsce package && vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.81.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3",
    "ts-loader": "^9.4.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "@vscode/test-electron": "^2.2.0"
  }
}